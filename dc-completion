_dc_completions()
{
    local cur cmd opts dc_dir tmp_dir env_file stack stack_name cache_file
    local -a stacks=() stack_names=() services=()
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    dc_dir="${DC_DIR:-${HOME}/docker}"
    env_file="${dc_dir}/.env"
    tmp_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/dc_stack_services"

    if [ "${COMP_WORDS[1]}" = "-v" ]; then
        cmd="${COMP_WORDS[2]}"
    else
        cmd="${COMP_WORDS[1]}"
    fi

    opts="install up down restart-stack-hard restart-stack-soft logs-stack start stop restart pull logs ips clean list help update version prune shell"

    case "$cmd" in
        up|down|restart-stack-hard|restart-stack-soft|logs-stack)
            if [ -d "${dc_dir}" ]; then
                mapfile -d '' stacks < <(find "${dc_dir}" \( -name compose.yaml -o -name compose.yml -o -name docker-compose.yaml -o -name docker-compose.yml \) -printf '%h\0' | sort -zu)
                for stack in "${stacks[@]}"; do
                    stack_names+=("${stack##*/}")
                done
            fi
            if [ "$cmd" != "logs-stack" ]; then
                stack_names=("all" "${stack_names[@]}")
            fi
            mapfile -t COMPREPLY < <(compgen -W "${stack_names[*]}" -- "${cur}")
            return 0
            ;;
        start|stop|restart|pull|logs|shell)
            if [ ! -d "${dc_dir}" ]; then
                return 0
            fi
            mkdir -p "${tmp_dir}"
            mapfile -d '' stacks < <(find "${dc_dir}" \( -name compose.yaml -o -name compose.yml -o -name docker-compose.yaml -o -name docker-compose.yml \) -printf '%h\0' | sort -zu)
            for stack in "${stacks[@]}"; do
                stack_name="${stack##*/}"
                cache_file="${tmp_dir}/${stack_name}"
                if [ ! -f "${cache_file}" ] || [ -n "$(find "${cache_file}" -mmin +30)" ]; then
                    docker compose --env-file "${env_file}" --env-file "${stack}/${stack_name}.env" --project-directory "${stack}" config --services > "${cache_file}" 2>/dev/null || true
                fi
            done
            if compgen -G "${tmp_dir}/*" > /dev/null; then
                mapfile -t services < <(cat "${tmp_dir}"/* 2>/dev/null)
                mapfile -t COMPREPLY < <(compgen -W "${services[*]}" -- "${cur}")
            fi
            return 0
            ;;
        install|ips|clean|list|help|version)
            return 0
            ;;
        prune)
            mapfile -t COMPREPLY < <(compgen -W "basic system" -- "${cur}")
            return 0
            ;;
        *)
            ;;
    esac

    mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
    return 0
}

complete -F _dc_completions dc
